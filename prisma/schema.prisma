generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One row per person. A guest is a User with isGuest = true; upgrading fills email and flips
// isGuest on the same row, so drafts, surprises and connections never need migrating.
// User.id is also the viaSocket user id (never the email).
model User {
  id          String   @id @default(cuid())
  isGuest     Boolean  @default(true)
  email       String?  @unique
  name        String?
  externalId  String?  @unique // id from the account provider, once upgraded
  passwordHash String?          // scrypt; only for email + password accounts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    Session[]
  surprises   Surprise[]
  uploads     Upload[]
  connections IntegrationConnection[]
  reminders   CalendarReminder[]
  aiUses      AiUse[]
}

// One row per AI call, for the daily allowance (guests get fewer than accounts).
model AiUse {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A recipient's reply: an emoji and an optional note, shown to the creator.
model Reaction {
  id         String   @id @default(cuid())
  surpriseId String
  surprise   Surprise @relation(fields: [surpriseId], references: [id], onDelete: Cascade)
  emoji      String
  message    String   @default("")
  fromName   String   @default("")
  createdAt  DateTime @default(now())

  @@index([surpriseId, createdAt])
}

// Friends invited by the creator to add a message. Nothing reaches the surprise until the creator adds it.
model Contribution {
  id         String   @id @default(cuid())
  surpriseId String
  surprise   Surprise @relation(fields: [surpriseId], references: [id], onDelete: Cascade)
  name       String
  message    String
  status     String   @default("pending") // pending | added | hidden
  createdAt  DateTime @default(now())

  @@index([surpriseId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // sha256 of the cookie value; the raw token is never stored
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

enum SurpriseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GenerationStatus {
  IDLE
  PENDING
  SUCCEEDED
  FAILED
}

model Surprise {
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status           SurpriseStatus   @default(DRAFT)
  occasion         String
  experienceType   String?
  recipientName    String
  creatorName      String
  title            String?
  input            Json             // validated studio answers (StudioInput)
  content          Json?            // validated experience JSON (ExperienceContent)
  theme            Json?            // { palette, font, motion }
  generationStatus GenerationStatus @default(IDLE)
  generationError  String?

  // Private link: hash for lookup, AES-GCM ciphertext so the creator can see and email it again.
  linkTokenHash    String?          @unique
  linkTokenEnc     String?
  linkRevokedAt    DateTime?
  linkExpiresAt    DateTime?
  linkPasswordHash String?          // optional extra lock on the private link (scrypt)
  // Group messages: friends add notes through their own link (hash only).
  inviteTokenHash  String?          @unique
  publishedAt      DateTime?
  archivedAt       DateTime?

  // Engagement: counts only, no recipient identity, IP or device data.
  openCount        Int              @default(0)
  lastOpenedAt     DateTime?
  progress         Int              @default(0) // 0-100
  completedAt      DateTime?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Versioned scene documents (src/engine/doc.ts). Recipients see the frozen published version.
  versions           SurpriseVersion[]
  publishedVersionId String?
  draftVersionId     String? // the document being edited; null = legacy single-experience content

  generations      AIGeneration[]
  deliveries       Delivery[]
  uploads          Upload[]
  reminders        CalendarReminder[]
  reactions        Reaction[]
  contributions    Contribution[]

  @@index([ownerId, status])
}

model AIGeneration {
  id          String           @id @default(cuid())
  surpriseId  String
  surprise    Surprise         @relation(fields: [surpriseId], references: [id], onDelete: Cascade)
  section     String?          // null = whole experience
  status      GenerationStatus
  model       String
  threadId    String
  error       String?
  output      Json?
  createdAt   DateTime         @default(now())

  @@index([surpriseId, createdAt])
}

model Upload {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  surpriseId  String?
  surprise    Surprise? @relation(fields: [surpriseId], references: [id], onDelete: Cascade)
  kind        String    @default("image") // image | audio | video
  status      String    @default("ready") // pending until the browser's direct upload is verified
  name        String    @default("")
  mime        String
  size        Int
  storageKey  String?   // object in R2 (or DATA_DIR/media locally); may be shared by duplicated surprises
  data        Bytes?    // legacy photos stored in the database before Phase 4
  createdAt   DateTime  @default(now())

  @@index([ownerId])
  @@index([surpriseId, kind])
  @@index([storageKey])
}

// A user's viaSocket connection to one app. authId is that user's credential reference: server only.
model IntegrationConnection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app       String   // viaSocket app slug, e.g. "gmail", "google-calendar"
  authId    String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, app])
}

enum DeliveryStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model Delivery {
  id             String         @id @default(cuid())
  surpriseId     String
  surprise       Surprise       @relation(fields: [surpriseId], references: [id], onDelete: Cascade)
  recipientEmail String
  subject        String
  message        String
  scheduledFor   DateTime       // now() for "send immediately"
  timezone       String
  status         DeliveryStatus @default(SCHEDULED)
  attempts       Int            @default(0)
  lastError      String?
  sentAt         DateTime?
  idempotencyKey String         @unique // client-supplied; a double-click cannot create two deliveries
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, scheduledFor])
}

enum ReminderStatus {
  CREATED
  FAILED
}

model CalendarReminder {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  surpriseId    String?
  surprise      Surprise?      @relation(fields: [surpriseId], references: [id], onDelete: SetNull)
  title         String
  occasionDate  DateTime
  remindMinutes Int            // minutes before the event
  timezone      String
  status        ReminderStatus
  eventId       String?
  eventLink     String?
  error         String?
  createdAt     DateTime       @default(now())
}

// One immutable snapshot of a surprise's scene document. Publishing points Surprise.publishedVersionId at one;
// later phases add autosave/undo history on the same table.
model SurpriseVersion {
  id         String   @id @default(cuid())
  surpriseId String
  surprise   Surprise @relation(fields: [surpriseId], references: [id], onDelete: Cascade)
  doc        Json
  source     String   // publish | autosave | ai | template | manual | legacy
  createdAt  DateTime @default(now())

  @@index([surpriseId, createdAt])
}
