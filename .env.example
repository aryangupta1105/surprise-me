# Copy to .env. Never commit .env.
DATABASE_URL="postgresql://user@localhost:5432/surpriseme"
APP_URL=http://localhost:3100            # public base URL; used in private links and emails
APP_SECRET=                              # openssl rand -hex 32 — encrypts stored share tokens
CRON_SECRET=                             # openssl rand -hex 24 — guards /api/cron/tick
# viaSocket product keys: run `npx -y viasocket-apps setup --no-open`
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=                  # server only
# Optional: 36Blocks login block for accounts (not a secret). Leave empty for guest-only.
NEXT_PUBLIC_BLOCKS_REFERENCE_ID=
