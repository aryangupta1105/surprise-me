# Copy to .env. Never commit .env.
# DATABASE_URL is optional: defaults to file:$DATA_DIR/surpriseme.db on Embarko, file:./data/dev.db locally
# DATABASE_URL=file:./data/dev.db
APP_URL=http://localhost:3100            # public base URL; used in private links and emails
APP_SECRET=                              # openssl rand -hex 32 — encrypts stored share tokens
TICK_SECRET=                             # openssl rand -hex 24 — guards /api/cron/tick
# viaSocket product keys: run `npx -y viasocket-apps setup --no-open`
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=                  # server only
# Optional: 36Blocks login block for accounts (not a secret). Leave empty for guest-only.
NEXT_PUBLIC_BLOCKS_REFERENCE_ID=

# S3-compatible media storage: Backblaze B2 (in use), Cloudflare R2, … Optional: without them media is stored under DATA_DIR/media.
# The bucket must be private, with a CORS rule allowing PUT (content-type header) from APP_URL (see README).
S3_ENDPOINT=                             # host only, e.g. s3.us-west-004.backblazeb2.com
S3_REGION=                               # e.g. us-west-004 (R2: auto)
S3_BUCKET=
S3_PREFIX=                               # e.g. surpriseme/ if the key may only write names starting with it
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=                    # server only
